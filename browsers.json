{
  "chrome": {
    "default": "latest",
    "versions": {
      "latest": {
        "driver": "chromedriver",
        "manager": "WebDriverManager",
        "headless": false,
        "options": [
          "--no-sandbox",
          "--disable-dev-shm-usage",
          "--window-size=1280,900"
        ]
      },
      "headless": {
        "driver": "chromedriver",
        "manager": "WebDriverManager",
        "headless": true,
        "options": [
          "--headless=new",
          "--no-sandbox",
          "--disable-dev-shm-usage",
          "--window-size=1280,900",
          "--disable-gpu"
        ]
      }
    }
  }
}
